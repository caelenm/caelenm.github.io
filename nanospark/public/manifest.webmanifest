{
  "name": "nanospark",
  "short_name": "nanospark",
  "description": "A self-custodial Bitcoin Lightning wallet on Spark. Static, no backend.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
